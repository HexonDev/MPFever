<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MPFever</AssemblyName>
    <RootNamespace>MPFever</RootNamespace>
    <Version>0.7.13-beta.2</Version>
    <Product>MPFever</Product>
    <Nullable>disable</Nullable>
    <!-- WebRequest/ServicePointManager (updates, reports, UPnP, server list) are kept; HttpClient is a change of its own -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <!-- a warning stops the build (build.bat, CI): none goes into a release unseen -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- texts of the other languages (French and English are in the code), keyed by the English text -->
    <EmbeddedResource Include="lang.json" LogicalName="lang.json" />
    <!-- (0.7.0) the game options of the feature modules, for the dedicated server's settings window (tools/gen_gameopts.py) -->
    <EmbeddedResource Include="gameopts.json" LogicalName="gameopts.json" />
  </ItemGroup>
</Project>
